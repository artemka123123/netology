<%- include('../port/layout-start.ejs', {title: title}) %>

<body data-bs-theme="dark">
    <%- include("../port/menu.ejs", { loggedIn: loggedIn })  %>

    <div class="mt-5 container d-flex justify-content-center">
        <h1><%= title %></h1>
    </div>

    <div class="mt-3 container justify-content-center">
        <h1 class="h3">Описание</h1>

        <h1 class="h5"><%- book.description %></h1>
    </div>

    <div class="mt-3 container justify-content-center">
        <h1 class="h3">Авторы</h1>

        <h1 class="h5"><%- book.authors %></h1>
    </div>

    <div class="mt-3 container justify-content-center">
        <h1 class="h3">Просмотры</h1>

        <h1 class="h5"><%- views %></h1>
    </div>

    <% if (loggedIn) { %>

    <div class="container d-flex justify-content-center mt-5">
        <a href="/books/edit/<%- book.id%>" class="btn btn-primary">Изменить</a>
    </div>

    <div class="container d-flex justify-content-center mt-5">


        <div class="container">
            <form>            
                <label for="comment">Оставить комментарий</label>
                <input type="text" class="form-control" name="comment" id="comment" aria-describedby="comment" placeholder="Ваш комментарий">
    
                <button type="button" onclick="sendComment()" class="btn btn-info mt-3">Отправить</button>
            </form>
        
            <h1 class="h2 mt-5">Комментарии</h1>

            <div id="comments">
                    
            </div>
        </div>
    </div>

    <% } %>

</body>

<% if (loggedIn) { %>

<script>
    var username = "<%= user.user %>";

    const bookID = location.pathname.split('/').pop();
    const socket = io.connect('/', {query: `book=${bookID}`});

    const commentInput = document.querySelector("#comment")
    const commentsDiv = document.querySelector("#comments")

    const getNewComment = (msg) => {

        return `
            <div class="mt-3 card text-bg-dark p-3">
                <h1 class="h4 card-title">${msg.username}</h1>
                <h1 class="h6 card-text">${msg.comment}</h1>
            </div>
        `
    }

    socket.on("comment", (msg) => {
        const newComment = getNewComment(msg)

        commentsDiv.insertAdjacentHTML("beforeend", newComment)
    })

    function sendComment() {
        const comment = commentInput.value

        if (comment.trim() == "") return;

        socket.emit("comment", {
            username: username,
            comment: comment
        })
    }

</script>

<% } %>

<%- include("../port/layout-end.ejs") %>